{
  "name": "@jio/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "check": "node --env-file-if-exists=../../.env --import tsx src/check.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jio/core": "workspace:*",
    "@jio/db": "workspace:*",
    "apify-client": "^2",
    "cheerio": "^1",
    "pg-boss": "^10",
    "pino": "^9",
    "rss-parser": "^3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.7",
    "vitest": "^2.1"
  }
}
